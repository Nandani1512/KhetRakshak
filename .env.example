# Copy to .env and fill in. NEVER commit .env.

# ---------- LLM (function-calling) ----------
# gemini | anthropic | openai   ("openai" = any OpenAI-compatible endpoint: OpenAI, Groq, Together, etc.)
LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ---------- Mandi prices ----------
# Register at https://data.gov.in -> My Account -> API key
DATA_GOV_IN_API_KEY=
# Agmarknet "Current daily price of various commodities" resource
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Agmarknet "Variety-wise Daily Market Prices Data of Commodity" (history since 2009)
AGMARKNET_HISTORY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
# CEDA Ashoka Agri Market API (historical trends). Fill both from CEDA's docs; smoke test skips if empty.
CEDA_API_BASE=
CEDA_API_KEY=

# ---------- Voice / language (Sarvam AI) ----------
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1

# ---------- Routing ----------
# OSRM public demo server needs no key (rate-limited). ORS is the backup.
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=

# ---------- Database (Supabase) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---------- Delivery ----------
TELEGRAM_BOT_TOKEN=
# Optional: if set, the smoke test sends one real test message to this chat
TELEGRAM_TEST_CHAT_ID=

# ---------- Geocoding (location sanity checks: sea / outside India) ----------
NOMINATIM_USER_AGENT=KhetRakshak-hackathon/0.1 (your-email@example.com)

# ---------- Backend ----------
CORS_ORIGINS=http://localhost:3000

# ---------- Smoke-test inputs (a real demo field location, NOT data) ----------
# Default: farmland near Ludhiana, Punjab -> destination: Khanna grain mandi
SMOKE_LAT=30.85
SMOKE_LON=75.70
SMOKE_DEST_LAT=30.705
SMOKE_DEST_LON=76.222
SMOKE_STATE=Punjab
SMOKE_MAX_CLOUD=20

# ---------- Production (Hugging Face Space secrets) ----------
# Public URL of the deployed app, e.g. https://<user>-khetrakshak.hf.space  (enables Telegram webhook)
PUBLIC_BASE_URL=
# Any random string; Telegram sends it back so the webhook can't be spoofed
TELEGRAM_WEBHOOK_SECRET=
# Protects the "break a data source" demo toggles; leave empty to allow anyone
ADMIN_TOKEN=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
